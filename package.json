{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node api.js && vite build",
    "build:optimized": "vite build --mode production --minify",
    "build:analyze": "vite build --mode production --analyze",
    "dev": "node api.js && vite",
    "dev:fast": "vite --force",
    "preview": "vite preview",
    "optimize": "npm run build:optimized && npm run cache:clear",
    "cache:clear": "php artisan cache:clear && php artisan config:clear && php artisan route:clear && php artisan view:clear",
    "performance:test": "php artisan performance:test",
    "database:optimize": "php artisan migrate && php artisan db:seed --class=PerformanceSeeder"
  },
  "dependencies": {
    "axios": "^1.8.2",
    "bootstrap": "^5.3.8",
    "chart.js": "^2.9.4",
    "jquery": "^4.0.0",
    "leaflet": "^1.9.4",
    "select2": "^4.1.0-rc.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "clean-webpack-plugin": "^4.0.0",
    "compression-webpack-plugin": "^10.0.0",
    "concurrently": "^9.0.1",
    "css-minimizer-webpack-plugin": "^5.0.1",
    "laravel-vite-plugin": "^1.2.0",
    "mini-css-extract-plugin": "^2.7.6",
    "tailwindcss": "^4.0.0",
    "terser": "^5.24.0",
    "vite": "^6.2.4",
    "vite-bundle-analyzer": "^0.7.0"
  }
}
